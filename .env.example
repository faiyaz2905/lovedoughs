# Optional overrides (set in Vercel Environment Variables for production)

# Canonical site origin — default is https://lovedoughs.vercel.app
# VITE_SITE_URL=https://lovedoughs.vercel.app

# Google Search Console HTML-tag verification token (content= value only)
# See docs/GSC-SETUP.md
# VITE_GOOGLE_SITE_VERIFICATION=

# Google Sheets order tracking (server-only — never add the VITE_ prefix)
# See docs/GOOGLE-SHEETS-ORDERS.md before setting these values.
# GOOGLE_SHEETS_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SHEETS_ORDERS_TAB=Orders
